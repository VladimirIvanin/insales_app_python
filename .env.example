# InSales Partner App — конфигурация окружения
# Скопируйте в .env и заполните своими значениями

# Режим локального demo (HTTP вместо HTTPS, только для 127.0.0.1/::1/localhost)
LOCAL_DEMO=1

# Данные приложения из личного кабинета InSales
INSALES_APP_ID=my-partner-app
INSALES_APP_SECRET=replace-with-your-app-secret

# Базовый URL, по которому InSales будет вызывать callback'и
APP_BASE_URL=http://127.0.0.1:8765

# Разрешённые домены магазинов (через запятую).
# Обязательный параметр. Пример:
# ALLOWED_SHOPS=shop-123.myinsales.ru,another-shop.myinsales.ru
ALLOWED_SHOPS=shop-123.myinsales.ru

# Путь к файлу БД (по умолчанию runtime/app.sqlite3)
APP_DB=runtime/app.sqlite3

# Адрес и порт сервера
BIND_HOST=127.0.0.1
PORT=8765

# Секретный ключ Flask (если не задан — генерируется случайно)
FLASK_SECRET_KEY=

# Режим отладки Flask (development/production)
FLASK_ENV=development